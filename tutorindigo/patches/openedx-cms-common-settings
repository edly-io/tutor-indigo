# The welcome / set-password email (sent by rwaq_features) builds the authn-MFE
# reset link via AUTHN_MICROFRONTEND_URL. Tutor sets this only for LMS; CMS
# Celery workers must have it too or the link falls back to the Studio domain.
AUTHN_MICROFRONTEND_URL = "{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ MFE_HOST }}/authn"

# Enrollment code share card (EDLYCSRWAQ-366). The QR codes open pages of the public WordPress site, so the
# site address follows WORDPRESS_HOST like MKTG_URLS above. ENROLLMENT_CODE_CARD (slogan, about line, logo, links)
# is left unset on purpose: the card shows only what is set.
RWAQ_PUBLIC_SITE_URL = "{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ WORDPRESS_HOST }}"
