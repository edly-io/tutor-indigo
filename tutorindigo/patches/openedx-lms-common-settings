PAT = '{{ PAT }}'

# Prepend the indigo theme templates dir so it overrides app-directories templates
# (e.g. ace_common, common/templates) which are otherwise found first by the app
# directories loader before the comprehensive theme loader gets a chance.
TEMPLATES[0]["DIRS"].insert(0, "/openedx/themes/indigo/lms/templates")
TEMPLATES[0]["DIRS"].insert(0, "/openedx/venv/src/rwaq-features/rwaq_features/templates")

# Redirect unauthenticated users from LMS homepage to the WordPress landing page.
# branding/views.py checks getattr(settings, 'ENABLE_MKTG_SITE') (top-level), not FEATURES.
FEATURES['ENABLE_MKTG_SITE'] = True
FEATURES['CUSTOM_CERTIFICATE_TEMPLATES_ENABLED'] = True
FEATURES['CERTIFICATES_HTML_VIEW'] = True
CERTIFICATE_TEMPLATE_LANGUAGES['ar'] = 'العربية'
ENABLE_MKTG_SITE = True
MKTG_URLS['ROOT'] = '{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ WORDPRESS_HOST }}'
MKTG_URLS['COURSES'] = '{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ WORDPRESS_HOST }}/courses/'
MKTG_URLS['ABOUT'] = '{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ WORDPRESS_HOST }}/about/'
MFE_CONFIG["MARKETING_SITE_URL"] = "{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ WORDPRESS_HOST }}"
MFE_CONFIG["FAVICON_URL"] = "{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ LMS_HOST }}/theming/asset/images/favicon.png"

