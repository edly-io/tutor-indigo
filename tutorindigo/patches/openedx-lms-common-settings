PAT = '{{ PAT }}'

# Prepend the indigo theme templates dir so it overrides app-directories templates
# (e.g. ace_common, common/templates) which are otherwise found first by the app
# directories loader before the comprehensive theme loader gets a chance.
TEMPLATES[0]["DIRS"].insert(0, "/openedx/themes/indigo/lms/templates")
TEMPLATES[0]["DIRS"].insert(0, "/openedx/venv/src/rwaq-features/rwaq_features/templates")

# Redirect unauthenticated users from LMS homepage to the WordPress landing page.
# branding/views.py checks getattr(settings, 'ENABLE_MKTG_SITE') (top-level), not FEATURES.
FEATURES['ENABLE_MKTG_SITE'] = True
FEATURES['CUSTOM_CERTIFICATE_TEMPLATES_ENABLED'] = True
FEATURES['CERTIFICATES_HTML_VIEW'] = True
CERTIFICATE_TEMPLATE_LANGUAGES['ar'] = 'العربية'
ENABLE_MKTG_SITE = True
MKTG_URLS['ROOT'] = '{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ WORDPRESS_HOST }}'
MKTG_URLS['COURSES'] = '{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ WORDPRESS_HOST }}/courses/'
MKTG_URLS['ABOUT'] = '{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ WORDPRESS_HOST }}/about/'
MFE_CONFIG["MARKETING_SITE_URL"] = "{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ WORDPRESS_HOST }}"
MFE_CONFIG["FAVICON_URL"] = "{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ LMS_HOST }}/theming/asset/images/favicon.png"

FEATURES["ENABLE_LEARNER_RECORDS"] = True

{% if SESSION_COOKIE_DOMAIN %}
SESSION_COOKIE_DOMAIN = "{{ SESSION_COOKIE_DOMAIN }}"
CSRF_COOKIE_DOMAIN = "{{ SESSION_COOKIE_DOMAIN }}"
LANGUAGE_COOKIE_DOMAIN = "{{ SESSION_COOKIE_DOMAIN }}"
# SHARED_COOKIE_DOMAIN scopes the cross-service login cookies set by
# user_authn/cookies.py: edxloggedin, edx-user-info and the edx-jwt-cookie-*
# pair (standard_cookie_settings() uses domain=settings.SHARED_COOKIE_DOMAIN).
# It defaults to "" and is NOT derived from SESSION_COOKIE_DOMAIN, so it must be
# set explicitly. Without it these cookies stay on the LMS host and WordPress
# (a sibling subdomain) never receives them.
SHARED_COOKIE_DOMAIN = "{{ SESSION_COOKIE_DOMAIN }}"
{% endif %}

COURSE_ACCESS_DURATION_MIN_WEEKS = {{ COURSE_ACCESS_DURATION_MIN_WEEKS }}
COURSE_ACCESS_DURATION_MAX_WEEKS = {{ COURSE_ACCESS_DURATION_MAX_WEEKS }}

# Learner self-enrollment from the LMS is disabled — all enrollment must flow
# through Programs (WordPress / admin paths). This makes every course
# invitation-only at the data layer, so CourseEnrollment.enroll(check_access=True)
# is rejected for non-staff. Privileged paths (MyProgramEnrollView, Admin Panel,
# instructor dashboard) all use check_access=False and are unaffected.
COURSES_INVITE_ONLY = True

# Shared secret for WordPress → LMS server-to-server enrollment calls.
# WordPress sends this in the X-Edx-Api-Key request header;
# rwaq-features validates it in _trusted_enroll() before enrolling the learner.
# Value is auto-generated by `tutor config save` and must be shared with the
# WordPress team via a secure channel.
EDX_API_KEY = "{{ RWAQ_EDX_API_KEY }}"
